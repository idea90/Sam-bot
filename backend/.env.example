# Server Settings
HOST=0.0.0.0
PORT=8000

# Voice Settings (Default Microsoft Neural Voice)
# Popular choices:
# en-US-GuyNeural (Sam - Male US)
# en-US-JennyNeural (Samantha - Female US)
# en-US-ChristopherNeural (Sam Deep - Male US)
# en-US-AriaNeural (Aria - Female US)
DEFAULT_VOICE=en-US-GuyNeural
DEFAULT_RATE=+0%
DEFAULT_PITCH=+0Hz

# AI Provider Settings
# Options: auto, gemini, openai, demo
LLM_PROVIDER=auto

# Optional API Keys (leave empty to use smart offline demo mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
